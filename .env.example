# Copia questo file in .env.local e inserisci i valori del progetto Supabase
# (Supabase → Project Settings → API). La chiave "anon" è pubblica per natura:
# la sicurezza la fanno le regole del database, non il segreto della chiave.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
